; HSync for VGA output — exact VESA DMT 800×600p60 timing.
;
; This rewrite (vs. the upstream 8.5-cycles-per-pixel version) drives
; the SM at exactly 1 cycle per pixel (40 MHz) so every cycle count
; below maps 1:1 to a pixel of the DMT spec — no fractional cycles,
; no clock-divider rounding. Drops the upstream's slight pixel-clock
; overshoot (40.16 MHz) that was the suspect for the colour gradient
; some monitors showed.
;
; DMT 800×600p60 (https://glenwing.github.io/docs/VESA-DMT-1.13.pdf):
;
;   pixel clock:     40.000 MHz exactly
;   active video:    800 px
;   front porch:     40 px
;   horiz. sync:    128 px (positive polarity)
;   back porch:      88 px
;   ----  total:   1056 px per line  →  37.879 kHz hsync
;   v_active:       600 lines
;   v_front:          1 line
;   v_sync:           4 lines (positive polarity)
;   v_back:          23 lines
;   ---- total:     628 lines per frame  →  60.317 Hz refresh
;
; At sys_clock = 160 MHz, sm_clkdiv = 4 → SM clock = 40 MHz, so 1 SM
; cycle = exactly 1 output pixel. Cycle counts below ARE pixel counts.

.program hsync_60

set pins, 0                 ; once: signal starts low
pull block                  ; once: CPU pushes (HACT + HFP - 2) = 838

.wrap_target                ; loop entered with signal LOW (carryover)

; ---- HACT + HFP — 840 cycles, signal low ----
;   mov x, osr        :   1 cycle (osr stays = 838)
;   jmp x-- loop      : 839 cycles (838 taken + 1 fall-through)
;   total             : 840 cycles
mov x, osr
visibleandfront:
    jmp x-- visibleandfront

; ---- HSYNC pulse — 128 cycles, signal HIGH (positive polarity) ----
set pins, 1 [31]            ; 32 cycles
nop [31]                    ; 32
nop [31]                    ; 32
nop [31]                    ; 32   → 128 total ✓

; ---- HSYNC back porch — 88 cycles, signal LOW, IRQ 0 near end ----
; IRQ 0 fires 2 cycles before end of HBP; vsync (running at same SM
; clock) sees it on its next cycle and raises IRQ 1; rgb (running 4×
; faster) starts drawing on the cycle after that, putting the first
; pixel's pin-change at the very start of HACT.
set pins, 0 [31]            ; 32 cycles
nop [31]                    ; 32   (cumulative 64)
nop [21]                    ; 22   (cumulative 86)
irq 0 [1]                   ;  2   (cumulative 88 ✓)

.wrap


% c-sdk {
static inline void hsync_60_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = hsync_60_program_get_default_config(offset);
    sm_config_set_set_pins(&c, pin, 1);
    // sys_clock = 240 MHz (overclock). clkdiv 6 → SM = 40 MHz exactly
    // (1 cycle = 1 pixel) — clean integer, counts unchanged from the
    // 160 MHz/clkdiv-4 version (same 40 MHz SM, no fractional jitter).
    sm_config_set_clkdiv_int_frac(&c, 6, 0);
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    pio_sm_init(pio, sm, offset, &c);
}
%}
