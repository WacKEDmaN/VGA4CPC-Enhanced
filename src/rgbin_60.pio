; rgbin_60.pio — CPC RGB capture for 60 Hz output mode.
;
; 60 Hz: sys_clock = 160 MHz. clkdiv 1 + 64/256 = 1.25 → SM clock 128 MHz.
; readpixel is 9 SM cycles per sample → 128 / 9 = 14.222 MHz sample rate.
;
; Why 14.222 MHz and not 16: sampling at exactly the CPC's 16 MHz pixel
; clock makes the red channel's mid-level read as black after a high-red
; border (a rate-coherence effect on this hardware — confirmed: at 16 MHz
; the bug shows at every sample phase; at any off-16 MHz rate it clears).
; 14.222 MHz decoheres it. The SM *clock* stays 128 MHz, an exact 8192
; cycles per 64 µs CPC line, so the sample phase is line-locked and the
; image is steady (no detune wobble).
;
; ~720 samples (CAP_VISIBLE_W) span 50.6 µs — the full active line — and
; are streamed straight to the VGA output (the output pixel clock stretches
; them across the visible width; no software resample). 8 µs back porch
; positions the window past the red comparator's post-border recovery.

.program rgbin_60

    pull block          ; CPU pushes (CAP_VISIBLE_W - 1) once at init
    mov y, osr          ; per-line sample-count - 1

    wait 1 gpio 10      ; sync to the next frame (VSYNC active)

.wrap_target
    wait 0 gpio 10      ; wait until VSYNC is over → active video begins
    wait 0 gpio 6       ; wait for HSYNC start (CSYNC falling)

    ; 3.5 µs pre-csync wait — smooth-scroll tolerance.
    set x, 12
waitloop:
    jmp x--, waitloop [31]
    nop [30]

    wait 1 gpio 6       ; wait for HSYNC end (CSYNC rising)

    ; Back porch: ~8 µs. Starting the sample window this late skips the red
    ; comparator's recovery transient after a high-red border — at ~6 µs the
    ; early samples land in it and mid-red reads black. 8 µs + 720 samples
    ; (50.6 µs) + sync fits inside the 64 µs CPC line (no dropped lines).
    set x, 31
porch:
    jmp x-- porch [31]
    nop

    ; 9 SM cycles per sample → 128 MHz / 9 = 14.222 MHz (see header).
    mov x, y
readpixel:
    in pins, 6
    push [6]
    jmp x-- readpixel
.wrap


% c-sdk {
static inline void rgbin_60_program_init(PIO pio, uint sm, uint offset, uint first_rgb_pin) {
    pio_sm_config c = rgbin_60_program_get_default_config(offset);
    sm_config_set_in_pins(&c, first_rgb_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, first_rgb_pin, 7, false);
    for (uint i = 0; i < 7; ++i) {
        pio_gpio_init(pio, first_rgb_pin + i);
    }
    sm_config_set_in_shift(&c, false, false, 6);
    // SM clock 128 MHz: clkdiv 1 + 64/256 = 1.25 at sys 160 MHz.
    sm_config_set_clkdiv_int_frac(&c, 1, 64);
    pio_sm_init(pio, sm, offset, &c);
}
%}
