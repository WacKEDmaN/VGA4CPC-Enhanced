; rgbin_60.pio — CPC RGB capture for 60 Hz output mode.
;
; Independent from the 50 Hz variant: each mode has its own back-porch
; wait so they can be tuned for their own sys_clock and detune range.
;
; 60 Hz: sys_clock = 160 MHz. SM clkdiv set in init (per-mode detune
; table in capture.c may rewrite at runtime). 8 SM cycles per sample.
; Back porch is the full 8 µs original timing — 60 Hz doesn't need
; heavy detune so the 800-sample loop fits inside the CPC line with
; this longer prelude, and the sample point lands in active video
; (no captured HBP at the start).

.program rgbin_60

    pull block          ; CPU pushes (CPC_ACTIVE_W - 1) once at init
    mov y, osr          ; per-line sample-count - 1

    wait 1 gpio 10      ; sync to the next frame (VSYNC active)

.wrap_target
    wait 0 gpio 10      ; wait until VSYNC is over → active video begins
    wait 0 gpio 6       ; wait for HSYNC start (CSYNC falling)

    ; 3.5 µs pre-csync wait — smooth-scroll tolerance.
    ;   1 + 13*32 + 31 = 448 cycles @ 128 MHz (rate similar at 60 Hz SM)
    set x, 12
waitloop:
    jmp x--, waitloop [31]
    nop [30]

    wait 1 gpio 6       ; wait for HSYNC end (CSYNC rising)

    ; Back porch: ~8 µs (original tuning — keeps the sample point in
    ; the CPC active video region for the reference hardware).
    set x, 31
porch:
    jmp x-- porch [31]
    nop

    ; 800 pixels — 8 SM cycles each
    mov x, y
readpixel:
    in pins, 6
    push [5]
    jmp x-- readpixel
.wrap


% c-sdk {
static inline void rgbin_60_program_init(PIO pio, uint sm, uint offset, uint first_rgb_pin) {
    pio_sm_config c = rgbin_60_program_get_default_config(offset);
    sm_config_set_in_pins(&c, first_rgb_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, first_rgb_pin, 7, false);
    for (uint i = 0; i < 7; ++i) {
        pio_gpio_init(pio, first_rgb_pin + i);
    }
    sm_config_set_in_shift(&c, false, false, 6);
    // Default detune: clkdiv 1+66/256 = 1.2578 at sys 160 MHz
    // → SM 127.2 MHz → 8 cyc sample = 15.90 MHz (−0.62 % off CPC).
    // capture.c apply_detune() may override at runtime.
    sm_config_set_clkdiv_int_frac(&c, 1, 66);
    pio_sm_init(pio, sm, offset, &c);
}
%}
