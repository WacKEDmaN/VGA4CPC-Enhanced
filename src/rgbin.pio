; rgbin.pio — CPC RGB capture, one push per pixel.
;
; Each push transfers one 6-bit sample as a 32-bit word (low byte).
; DMA uses DMA_SIZE_8 to extract just the low byte.
;
; SM clock = sys_clock (128 MHz). 8 cycles per sample → 16 MHz
; sample rate, matching the CPC's mode-2 pixel clock exactly.

.program rgbin

    pull block          ; CPU pushes (CPC_ACTIVE_W - 1) once at init
    mov y, osr          ; per-line sample-count - 1

    wait 1 gpio 10      ; sync to the next frame (VSYNC active)

.wrap_target
    wait 0 gpio 10      ; wait until VSYNC is over → active video begins
    wait 0 gpio 6       ; wait for HSYNC start (CSYNC falling)

    ; Exactly 3.5 µs wait (448 cycles @ 128 MHz) before re-checking
    ; CSYNC — smooth-scroll tolerance. The trailing nop[30] is part of
    ; the upstream timing budget and matters: getting this short by even
    ; a few cycles drifts the sample point off the CPC pixel centre and
    ; produces edge flicker / coloured fringes around transitions.
    ;   1 + 13*32 + 31 = 448
    set x, 12
waitloop:
    jmp x--, waitloop [31]
    nop [30]

    wait 1 gpio 6       ; wait for HSYNC end (CSYNC rising)

    ; Back porch: ~8 µs
    set x, 31
porch:
    jmp x-- porch [31]
    nop

    ; 800 pixels — 8 SM cycles each (in + push[5] + jmp = 1+6+1)
    mov x, y
readpixel:
    in pins, 6
    push [5]
    jmp x-- readpixel
.wrap


% c-sdk {
static inline void rgbin_program_init(PIO pio, uint sm, uint offset, uint first_rgb_pin, bool is_50hz) {
    pio_sm_config c = rgbin_program_get_default_config(offset);
    sm_config_set_in_pins(&c, first_rgb_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, first_rgb_pin, 7, false);
    for (uint i = 0; i < 7; ++i) {
        pio_gpio_init(pio, first_rgb_pin + i);
    }
    sm_config_set_in_shift(&c, false, false, 6);
    // Per-mode clkdiv:
    //   50 Hz: clkdiv 1 (integer). sys_clock ≈ 125 MHz via clock_configure
    //          → SM ~125 MHz → 8 cyc sample = 15.625 MHz, drifts across
    //          CPC pixels → colour bug fixed.
    //   60 Hz: clkdiv 1+64/256 = 1.25 (matches HEAD). sys_clock = 160 MHz
    //          → SM = 128 MHz → 8 cyc = 16 MHz exact sample. This locks
    //          onto CPC pixel phase (= colour bug) but gives the right
    //          capture timing for the image to fit the monitor exactly,
    //          which is the priority for 60 Hz crisp DMT 40 MHz output.
    //          Accepted trade-off: 60 Hz has colour bug, but image is
    //          correctly sized.
    if (is_50hz) {
        sm_config_set_clkdiv_int_frac(&c, 1, 0);
    } else {
        sm_config_set_clkdiv_int_frac(&c, 1, 64);
    }
    pio_sm_init(pio, sm, offset, &c);
}
%}
