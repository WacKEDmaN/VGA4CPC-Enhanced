; rgbin_50.pio — CPC RGB capture for 50 Hz output mode.
;
; 50 Hz: sys_clock = 256 MHz (OVERCLOCK, = 128 × 2). clkdiv 1.0 → SM clock
; = full 256 MHz. The read loop is 18 SM cycles per sample → 256 / 18 =
; 14.222 MHz — EXACTLY 128/9, the same proven colour-safe rate as the old
; 128 MHz / 9-cycle build, so the red colour fix is unchanged.
;
; Why overclock: the per-line jitter is the `wait 0 gpio 6` HSYNC re-sync
; quantising to one SM-clock cycle. At 256 MHz that cycle is 3.9 ns vs
; 7.8 ns at 128 MHz → the per-line jitter is halved. 256 MHz is exactly
; 16384 cycles per 64 µs CPC line, so the phase is line-locked. (Needs a
; core-voltage bump, done in main.c.) Every 50 Hz clock simply doubled
; from the 128 MHz build, so all output/sync frequencies are unchanged.
;
; 720 samples span ~50.6 µs (the active line). pre-csync wait and back
; porch are re-sized in SM cycles to keep their real-time durations
; (3.5 µs / 8 µs) now the SM runs at 256 MHz.

.program rgbin_50

    pull block          ; CPU pushes (CAP_VISIBLE_W - 1) once at init
    mov y, osr          ; per-line sample-count - 1

    wait 1 gpio 10      ; sync to the next frame (VSYNC active)

.wrap_target
    wait 0 gpio 10      ; wait until VSYNC is over → active video begins
    wait 0 gpio 6       ; wait for HSYNC start (CSYNC falling)

    ; 3.5 µs pre-csync wait — smooth-scroll tolerance.
    ;   1 + 27*32 + 31 = 896 cycles @ 256 MHz = 3.50 µs
    set x, 26
waitloop:
    jmp x--, waitloop [31]
    nop [30]

    wait 1 gpio 6       ; wait for HSYNC end (CSYNC rising)

    ; Back porch: ~8 µs (skips the red comparator's post-border recovery —
    ; do NOT shorten). `set` immediate maxes at 31, so two loops:
    ;   2 * (1 + 32*32) + 1 = 2051 cycles @ 256 MHz ≈ 8.01 µs.
    set x, 31
porch:
    jmp x-- porch [31]
    set x, 31
porch2:
    jmp x-- porch2 [31]
    nop

    ; 18 SM cycles per sample (1 + push[15]=16 + jmp = 18) → 256/18 =
    ; 14.222 MHz = 128/9 (exact proven colour rate, finer clock). See header.
    mov x, y
readpixel:
    in pins, 6
    push [15]
    jmp x-- readpixel
.wrap


% c-sdk {
static inline void rgbin_50_program_init(PIO pio, uint sm, uint offset, uint first_rgb_pin) {
    pio_sm_config c = rgbin_50_program_get_default_config(offset);
    sm_config_set_in_pins(&c, first_rgb_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, first_rgb_pin, 7, false);
    for (uint i = 0; i < 7; ++i) {
        pio_gpio_init(pio, first_rgb_pin + i);
    }
    sm_config_set_in_shift(&c, false, false, 6);
    // Integer clkdiv 1.0 → full 256 MHz SM (3.9 ns tick). 18-cycle loop
    // → 14.222 MHz sample rate (= 128/9, the exact proven colour value).
    sm_config_set_clkdiv_int_frac(&c, 1, 0);
    pio_sm_init(pio, sm, offset, &c);
}
%}
