; RGB for VGA output
; by gregg, based on Hunter Adams' library

.program rgb_50

; This program just sends pixels to VGA. This version handles 720x576p50 output mode in CEA-861 standard.
; But there is one extra trick added - pixels are sent a bit faster, so in the time that we should send 720 pixels,
; we actually send 800, so this way we can show the whole Amstrad screen (at least horizontally) including overscan.
; The timings in other state machines follow the timing of 720x576p50 mode so monitor will still detect it as 720x576p50.
;
; 50 Hz mode runs at sys_clock = 128 MHz. We don't set a clock divider here, so the SM
; runs at full speed (128 MHz). 4 cycles per pixel gives 32 MHz pixel rate — close
; enough to the ideal 30 MHz for the 800-into-720 overscan trick.

pull block 					; Pull number of active pixels per line - 1
mov y, osr 					; And keep value in register y

.wrap_target            ; One iteration per line

set pins, 0 			; Zero RGB pins during blank period (hsync + porches)
mov x, y                ; x will be used to count cycles

; Wait for hsync's back-porch-end IRQ 1, then delay an extra 31 cycles
; before pulling the first pixel byte. Without that delay the first
; pin change lands ~9 captured-pixel-widths BEFORE the monitor's HACT
; window opens, so those pixels are drawn during HBP and lost. The
; 31-cycle pad (≈ 8.75 captured pixels at rgb_50's 4-cycle/pixel
; layout) shifts the first pin change to roughly the start of HACT.
wait 1 irq 1 [31]

onepixel:                   ; 4 cycles per pixel total (= 32 MHz @ 128 MHz SM clock):
	pull block				  ; pull color value     (1 cycle)
    out pins, 6 [1] 		  ; set output rgb pins  (1 cycle + 1 delay = 2)
	jmp x-- onepixel		  ; repeat for each pixel (1 cycle)

.wrap


% c-sdk {
static inline void rgb_50_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = rgb_50_program_get_default_config(offset);
    sm_config_set_set_pins(&c, pin, 6);   // 2 pins per color, 6 in total
    sm_config_set_out_pins(&c, pin, 6);
    for (int i = 0; i < 6; ++i) {
        pio_gpio_init(pio, pin + i);
    }
    // 50 Hz mode runs at sys_clock = 128 MHz. CEA-861 720x576p50 pixel
    // clock = 27 MHz. We now send exactly 720 captured pixels per line
    // (CAP_VISIBLE_W), so 720 px @ 27 MHz = 26.67 µs fills the HACT 1:1.
    // 4 SM cycles per pixel → SM = 108 MHz → clkdiv = 128/108 = 1.18519
    //   int 1, frac 47/256 = 1.18359 → SM = 108.15 MHz → pixel 27.04 MHz.
    sm_config_set_clkdiv_int_frac(&c, 1, 47);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 6, true);
    pio_sm_init(pio, sm, offset, &c);
}
%}
